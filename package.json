{
  "name": "create-code-buddy",
  "version": "1.0.0-beta.3",
  "description": "A CLI tool to scaffold agentic context and rules.",
  "main": "dist/index.js",
  "bin": {
    "create-code-buddy": "dist/index.js",
    "ccb": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "cli",
    "scaffold",
    "ai",
    "agent"
  ],
  "files": [
    "dist"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "picocolors": "^1.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
